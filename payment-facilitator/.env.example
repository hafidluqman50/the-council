# b402 payment facilitator — environment variables
# Copy to .env and fill in real values. Never commit .env.

# Required. Private key of the EOA that submits transferWithAuthorization
# transactions and pays their gas. For local development, generate a fresh
# throwaway keypair (e.g. `ethers.Wallet.createRandom()`) — do not reuse a
# real/funded key. This wallet needs BSC Testnet BNB to pay gas before /settle
# can succeed; a zero-balance wallet is fine for exercising /verify and for
# confirming /settle fails for the right reason.
RELAYER_PRIVATE_KEY=0xyourprivatekeyhere

# Required. On-chain address of the deployed B402RelayerV2 contract — this is
# NOT the relayer wallet's own address (that's derived from
# RELAYER_PRIVATE_KEY above). It is the shared contract that verifies EIP-712
# signatures and calls transferWithAuthorization on the token.
# BSC Testnet (chainId 97), confirmed to have deployed bytecode 2026-09-23:
#   0xd67eF16fa445101Ef1e1c6A9FB9F3014f1d60DE6
# BSC Mainnet (chainId 56), per upstream b402 README, NOT independently verified:
#   0xE1C2830d5DDd6B49E9c46EbE03a98Cb44CD8eA5a
B402_RELAYER_ADDRESS=0xYourRelayerContractAddress

# Required. "mainnet" or "testnet" — selects chainId (56/97), RPC URL, and the
# hardcoded token whitelist below.
NETWORK=testnet

# Optional. Defaults hardcoded in src/server.ts are used if unset. The default
# testnet RPC (data-seed-prebsc-1-s1.binance.org) was observed unresponsive
# during local verification (2026-09-23); publicnode.com's endpoint worked.
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
BSC_TESTNET_RPC_URL=https://bsc-testnet-rpc.publicnode.com

# Optional. HTTP port the Express server listens on.
PORT=3402

# Optional. If either is left blank, Supabase request/settlement logging is
# disabled entirely (a no-op — the service still boots and both endpoints
# work normally). Only needed for analytics/b402scan-style logging, not for
# /verify or /settle to function. See docs/plans/council-payment-rail.md §2
# for what schema this expects if you do provision a project.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key-here
