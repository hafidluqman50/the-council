APP_ENV=development
PORT=8080
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgres://root:samarinda@127.0.0.1:5432/the_council

LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=
LLM_ORCHESTRATOR_MODEL=deepseek-v4-pro
LLM_PANEL_MODEL=deepseek-flash
LLM_VALIDATOR_MODEL=deepseek-flash

# Real web search for agent citations — get a free key at tavily.com
TAVILY_API_KEY=

# For local dev: run `anvil --fork-url https://data-seed-prebsc-1-s1.bnbchain.org:8545 --chain-id 97`
# and point this at it. Switch to the real testnet RPC only for an actual funded deployment.
BSC_RPC_URL=http://localhost:8545
BSC_CHAIN_ID=97
IDENTITY_REGISTRY_ADDRESS=0x8004A818BFB912233c491871b3d84c89A494BD9e
REPUTATION_REGISTRY_ADDRESS=0x8004B663056A597Dffe9eCcC1965A193B7388713
VALIDATION_REGISTRY_ADDRESS=
MINTER_PRIVATE_KEY=

# See docs/plans/council-payment-rail.md for the full gate design.
PAYMENT_ENABLED=false
B402_FACILITATOR_URL=http://localhost:3402
# Deployed B402RelayerV2 contract on BSC Testnet, not the relayer wallet's own address.
B402_RELAYER_ADDRESS=0xd67eF16fa445101Ef1e1c6A9FB9F3014f1d60DE6
B402_PAY_TO_ADDRESS=
B402_ASSET_ADDRESS=0x337610d27c682E347C9cD60BD4b3b107C9d34dDd
B402_PRICE_ATOMIC=1000000000000000000
