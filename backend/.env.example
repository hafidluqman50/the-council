APP_ENV=development
PORT=8080
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgres://root:samarinda@127.0.0.1:5432/the_council

LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=
LLM_ORCHESTRATOR_MODEL=deepseek-v4-pro
LLM_PANEL_MODEL=deepseek-flash
LLM_VALIDATOR_MODEL=deepseek-flash

# Real web search for agent citations — get a free key at tavily.com
TAVILY_API_KEY=

# Real BSC Testnet RPC — for a local anvil fork instead, run:
# `anvil --fork-url https://data-seed-prebsc-1-s1.bnbchain.org:8545 --chain-id 97`
# and point this at http://localhost:8545 instead.
BSC_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
BSC_CHAIN_ID=97
IDENTITY_REGISTRY_ADDRESS=0x8004A818BFB912233c491871b3d84c89A494BD9e
REPUTATION_REGISTRY_ADDRESS=0x8004B663056A597Dffe9eCcC1965A193B7388713
VALIDATION_REGISTRY_ADDRESS=
MINTER_PRIVATE_KEY=

# Deployed CouncilThreadRegistry on BSC Testnet — see smart-contract/src/CouncilThreadRegistry.sol
